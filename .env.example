CREDITLENS_JWT_SECRET=change-me-to-a-long-random-string
CREDITLENS_DB=creditlens.db
CREDITLENS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CREDITLENS_MAX_UPLOAD=2000000
CREDITLENS_JWT_MINUTES=10080
CREDITLENS_ENV=development
CREDITLENS_AUTH_RATE=10
# Optional: PostgreSQL (e.g. Neon) instead of the local SQLite file. Example:
# CREDITLENS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
